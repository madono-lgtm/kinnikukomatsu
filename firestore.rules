rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 会員プロフィール（ドキュメントID = Auth UID）
    // 予約画面で他会員の名前を表示するため、読み取りはログイン済み全員に許可。
    // チケットの消費・返却/相乗り時の返却をアプリがクライアント側で行うため、
    // 更新もログイン済みに許可するが、role（権限）の変更だけは管理者に限定する。
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // 営業時間などの設定（ドキュメントID固定 "1"）
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 予約
    match /reservations/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin() || resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    // 相乗り参加者
    match /reservation_participants/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      // 本人・予約オーナー（枠ごと取消）・管理者が削除できる
      allow delete: if isAdmin()
        || resource.data.user_id == request.auth.uid
        || get(/databases/$(database)/documents/reservations/$(resource.data.reservation_id)).data.user_id == request.auth.uid;
      allow update: if false;
    }

    // グループ
    match /groups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /group_members/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin() || resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    // チケット履歴（本人と管理者のみ閲覧可）
    match /ticket_history/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ヒアリングシート（個人情報のため本人と管理者のみ）
    match /intake_sheets/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin() || (signedIn() && request.resource.data.user_id == request.auth.uid);
    }
  }
}
